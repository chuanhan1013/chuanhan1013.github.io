---
import AwardStrip from '@/components/AwardStrip.astro';
import EducationCard from '@/components/EducationCard.astro';
import Hero from '@/components/Hero.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ResearchCard from '@/components/ResearchCard.astro';
import SectionHead from '@/components/SectionHead.astro';
import SkillGroup from '@/components/SkillGroup.astro';
import Timeline from '@/components/Timeline.astro';
import { awards, education, skills } from '@/data/education';
import { experience } from '@/data/experience';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { getAllProjects, usedCategories } from '@/lib/projects';

const all = await getAllProjects();
const research = all.filter((p) => p.data.kind === 'research');
const projects = all.filter((p) => p.data.kind === 'project');
const filters = usedCategories(projects);

/**
 * Tile sizes for the full, ordered lineup on wide screens: two large features, then rows of
 * three (medium) or four (small) chosen so that no row is left with a gap.
 */
function sizeTiles(count: number): ('lg' | 'md' | 'sm')[] {
  const rest = Math.max(0, count - 2);
  // rows of three first; switch to rows of four for whatever divides evenly
  let threes = Math.floor(rest / 3);
  while (threes > 0 && (rest - threes * 3) % 4 !== 0) threes--;
  const medium = (rest - threes * 3) % 4 === 0 ? threes * 3 : rest; // no clean split: all medium
  return Array.from({ length: count }, (_, i) => (i < 2 ? 'lg' : i < 2 + medium ? 'md' : 'sm'));
}
const tileSizes = sizeTiles(projects.length);
---

<SiteLayout home>
  <div id="top"></div>
  <Hero />

  <section id="research" class="section" aria-labelledby="research-title">
    <div class="container">
      <SectionHead id="research" eyebrow="Featured" title="Research" />
      <div class="research-list">
        {research.map((entry) => (
          <ResearchCard entry={entry} />
        ))}
      </div>
    </div>
  </section>

  <section id="projects" class="section" aria-labelledby="projects-title">
    <div class="container">
      <SectionHead
        id="projects"
        eyebrow="Selected work"
        title="Projects"
        description="Open a project for the write-up, results and code."
      />
      <div class="filter" role="group" aria-label="Filter projects by area" data-filter>
        <button type="button" aria-pressed="true" data-category="all">
          All <span class="count">{projects.length}</span>
        </button>
        {filters.map((c) => (
          <button type="button" aria-pressed="false" data-category={c.key}>
            {c.short} <span class="count">{c.count}</span>
          </button>
        ))}
      </div>
      <ul class="project-grid" data-project-grid>
        {projects.map((entry, i) => (
          <li
            class:list={[
              'reveal',
              `tile--${tileSizes[i]}`,
              { 'tile--wide': i === 0 || (i === 1 && projects.length % 2 === 0) },
            ]}
            data-categories={entry.data.categories.join(' ')}
          >
            <ProjectCard entry={entry} />
          </li>
        ))}
      </ul>
      <p class="sr-only" aria-live="polite" data-filter-status></p>
    </div>
  </section>

  <section id="experience" class="section" aria-labelledby="experience-title">
    <div class="container">
      <SectionHead id="experience" eyebrow="Background" title="Experience" />
      <Timeline entries={experience} />
    </div>
  </section>

  <section id="education" class="section" aria-labelledby="education-title">
    <div class="container">
      <SectionHead id="education" eyebrow="Education" title="Education & Skills" />
      <div class="education-grid">
        {education.map((entry) => (
          <EducationCard entry={entry} />
        ))}
      </div>
      <div class="skills">
        {skills.map((group) => (
          <SkillGroup group={group} />
        ))}
      </div>
      <AwardStrip awards={awards} />
    </div>
  </section>
</SiteLayout>
