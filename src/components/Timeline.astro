---
import type { TimelineEntry } from '@/data/types';
import LogoMark from './LogoMark.astro';

interface Props {
  entries: TimelineEntry[];
}

const { entries } = Astro.props;
---

<ol class="timeline">
  {entries.map((entry) => (
    <li class:list={['timeline__item', 'reveal', { 'timeline__item--featured': entry.featured }]}>
      <div class="timeline__when">
        {/* each date range stays on one line */}
        {entry.when.split(' · ').map((range, i) => (
          <>
            {i > 0 && ' · '}
            <span style="white-space:nowrap">{range}</span>
          </>
        ))}
      </div>
      <div>
        <p class="timeline__label">{entry.label}</p>
        <div class="timeline__title">
          {entry.logo && <LogoMark {...entry.logo} />}
          <h3>
            {entry.url ? (
              <a class="org-link" href={entry.url} target="_blank" rel="noopener noreferrer">
                {entry.title}
              </a>
            ) : (
              entry.title
            )}
          </h3>
        </div>
        <p>{entry.text}</p>
      </div>
    </li>
  ))}
</ol>
