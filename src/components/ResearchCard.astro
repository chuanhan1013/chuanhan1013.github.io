---
import { projectUrl, transitionName, type ProjectEntry } from '@/lib/projects';
import Gallery from './Gallery.astro';
import LogoMark from './LogoMark.astro';
import Results from './Results.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  entry: ProjectEntry;
}

const { entry } = Astro.props;
const p = entry.data;
---

<article class="research-card reveal" id={entry.id}>
  <Gallery
    items={p.media.items}
    label={`${p.title} media`}
    badge={p.media.badge}
    transitionName={transitionName(entry, 'cover')}
  />
  <div class="research-card__body">
    <div class="card-meta">
      <StatusBadge status={p.status} />
      <span>{p.period}</span>
    </div>
    <h3 style={`view-transition-name:${transitionName(entry, 'title')}`}>
      <a href={projectUrl(entry)}>{p.title}</a>
    </h3>
    <p class="card-context">
      {p.contextLogo && <LogoMark {...p.contextLogo} />}
      <span>{p.context}</span>
    </p>
    <p class="research-card__summary">{p.blurb ?? p.summary}</p>
    {p.results && <Results results={p.results} />}
    {p.tags && (
      <ul class="pill-list" style="margin-top:18px" aria-label="Topics">
        {p.tags.map((tag) => (
          <li class="pill">{tag}</li>
        ))}
      </ul>
    )}
    <div class="research-card__footer">
      <a class="text-link" href={projectUrl(entry)}>
        Read more <span class="arrow">→</span>
      </a>
    </div>
  </div>
</article>
