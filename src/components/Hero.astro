---
import { hero, person, profile } from '@/data/site';
import { iconUrl } from '@/lib/icons';
import TrajectoryArt from './TrajectoryArt.astro';

// "{…}" in the headline marks the highlighted phrase.
const [before = '', highlight = '', after = ''] = hero.headline.split(/[{}]/);
---

<section id="about" class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div>
      <div class="hero__identity rise" style="--i:0">
        <img
          class="hero__avatar"
          src={profile.avatar.src}
          alt={profile.avatar.alt}
          width="76"
          height="76"
          loading="eager"
          fetchpriority="high"
        />
        <div>
          <p class="hero__name">{person.name}</p>
          <p class="hero__role">{profile.role}</p>
        </div>
      </div>
      <p class="eyebrow rise" style="--i:1">
        {hero.eyebrow}
      </p>
      <h1 id="hero-title" class="hero__headline rise" style="--i:2">
        {before}
        <em>{highlight}</em>
        {after}
      </h1>
      {hero.ledes.map((lede, i) => (
        <p class="hero__lede rise" style={`--i:${3 + i}`}>
          {lede}
        </p>
      ))}
      <div class="hero__actions rise" style="--i:5">
        <a class="button button--primary" href="#projects">
          View projects
        </a>
        <a class="button" href="/cv.html">
          Curriculum vitae
        </a>
        {profile.links.map((link) => (
          <a class="button" href={link.href} {...(link.external && { target: '_blank', rel: 'noreferrer' })}>
            <img src={iconUrl(link.icon)} alt="" width="16" height="16" />
            {link.label}
          </a>
        ))}
      </div>
      <p class="hero__open-to rise" style="--i:6">
        {hero.openTo}
      </p>
      <dl class="hero__facts rise" style="--i:7">
        {hero.facts.map((fact) => (
          <div>
            <dt>{fact.term}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
      <ul class="pill-list hero__interests rise" style="--i:8" aria-label="Research interests">
        {hero.interests.map((interest) => (
          <li class="pill">{interest}</li>
        ))}
      </ul>
    </div>
    <div class="rise" style="--i:3">
      <TrajectoryArt />
    </div>
  </div>
</section>
