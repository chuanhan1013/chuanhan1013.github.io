---
import { PLACEHOLDER_SRC } from '@/lib/media';
---

<div class="media-lightbox" role="dialog" aria-modal="true" aria-label="Media viewer">
  <button class="lb-close" type="button" aria-label="Close media">
    ×
  </button>
  <button class="lb-nav lb-prev" type="button" aria-label="Previous media">
    ‹
  </button>
  <div class="lb-stage">
    <img src={PLACEHOLDER_SRC} alt="" />
  </div>
  <button class="lb-nav lb-next" type="button" aria-label="Next media">
    ›
  </button>
  <p class="lb-caption"></p>
</div>
