---
/**
 * Hero illustration: an end-effector path threading between the swept volumes of two
 * moving obstacles — a nod to the owner's motion-planning research. Purely decorative.
 * CSS animates the obstacles and path; src/scripts/trajectory.ts moves the end-effector
 * along the path (static when reduced motion is preferred).
 */
const path = 'M70 270 C 112 270, 118 218, 164 208 S 210 128, 262 118 S 376 116, 420 95';
---

<figure class="hero__art" aria-hidden="true">
  <svg class="traj" viewBox="0 0 480 340">
    <defs>
      <pattern id="traj-dots" width="20" height="20" patternUnits="userSpaceOnUse">
        <circle cx="1" cy="1" r="1" fill="#c7d4e0"></circle>
      </pattern>
      <linearGradient id="traj-stroke" x1="0" x2="1" y1="1" y2="0">
        <stop offset="0" stop-color="#123f6b"></stop>
        <stop offset="0.55" stop-color="#2f7fc1"></stop>
        <stop offset="1" stop-color="#237276"></stop>
      </linearGradient>
      <radialGradient id="traj-halo">
        <stop offset="0.55" stop-color="#e07a3f" stop-opacity="0.16"></stop>
        <stop offset="1" stop-color="#e07a3f" stop-opacity="0"></stop>
      </radialGradient>
    </defs>
    <rect width="480" height="340" rx="14" fill="url(#traj-dots)"></rect>

    <!-- Swept volumes: where each obstacle can be while the arm moves. -->
    <rect class="traj__sweep" x="232" y="168" width="64" height="150" rx="32"></rect>
    <rect class="traj__sweep" x="128" y="22" width="64" height="134" rx="32"></rect>

    <!-- Moving obstacles. -->
    <g class="traj__obstacle traj__obstacle--a">
      <circle cx="264" cy="232" r="30" fill="url(#traj-halo)"></circle>
      <circle cx="264" cy="232" r="13" fill="#e07a3f"></circle>
    </g>
    <g class="traj__obstacle traj__obstacle--b">
      <circle cx="160" cy="90" r="30" fill="url(#traj-halo)"></circle>
      <circle cx="160" cy="90" r="13" fill="#e07a3f"></circle>
    </g>

    <!-- Earlier plans (ghosted) and the current plan. -->
    <path class="traj__ghost" d="M70 270 C 140 262, 150 236, 214 232 S 330 214, 420 95"></path>
    <path class="traj__path" d={path} pathLength="1"></path>

    <!-- Start, goal, end-effector. -->
    <circle cx="70" cy="270" r="6" fill="#fff" stroke="#123f6b" stroke-width="3"></circle>
    <g transform="translate(420 95)">
      <circle r="13" fill="none" stroke="#237276" stroke-width="2" stroke-dasharray="3 4"></circle>
      <circle r="5" fill="#237276"></circle>
    </g>
    <g class="traj__ee" data-path={path}>
      <circle r="10" fill="#2f7fc1" fill-opacity="0.18"></circle>
      <circle r="5.5" fill="#123f6b"></circle>
    </g>

    <g class="traj__labels">
      <text x="58" y="298">
        start
      </text>
      <text x="402" y="72">
        goal
      </text>
      <text x="300" y="312">
        moving obstacle
      </text>
    </g>
  </svg>
  <figcaption>
    <span>Illustration · reaching around moving obstacles</span>
    <span>swept volume ▢</span>
  </figcaption>
</figure>

<style>
  .traj {
    width: 100%;
    height: auto;
    border-radius: 14px;
    background: linear-gradient(180deg, #fbfdff, #f1f6fa);
  }
  .traj__sweep {
    fill: rgba(224, 122, 63, 0.06);
    stroke: rgba(224, 122, 63, 0.35);
    stroke-dasharray: 4 5;
  }
  .traj__ghost {
    fill: none;
    stroke: #9fb4c8;
    stroke-width: 1.5;
    stroke-dasharray: 2 6;
    stroke-linecap: round;
  }
  .traj__path {
    fill: none;
    stroke: url(#traj-stroke);
    stroke-width: 3.5;
    stroke-linecap: round;
  }
  .traj__labels text {
    fill: #566475;
    font-size: 12px;
    font-weight: 600;
    font-family: var(--font);
  }
  .traj__ee {
    transform: translate(420px, 95px);
  }
  @media (prefers-reduced-motion: no-preference) {
    .traj__path {
      stroke-dasharray: 1;
      animation: traj-draw 6s var(--ease-in-out) infinite;
    }
    .traj__obstacle--a {
      animation: traj-bob 6s var(--ease-in-out) infinite;
    }
    .traj__obstacle--b {
      animation: traj-bob 6s var(--ease-in-out) infinite reverse;
    }
    .traj__ghost {
      animation: traj-ghost 6s ease infinite;
    }
  }
  @keyframes traj-draw {
    0% {
      stroke-dashoffset: 1;
    }
    55%,
    88% {
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }
  @keyframes traj-bob {
    0%,
    100% {
      transform: translateY(-34px);
    }
    50% {
      transform: translateY(34px);
    }
  }
  @keyframes traj-ghost {
    0%,
    100% {
      opacity: 0.25;
    }
    50% {
      opacity: 0.7;
    }
  }
</style>
