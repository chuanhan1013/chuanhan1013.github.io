---
/**
 * Card media. One item → a single framed image; several → a carousel.
 * Carousel behaviour lives in `src/scripts/carousel.ts`, the viewer in `lightbox.ts`.
 */
import type { MediaGallery, MediaItem } from '@/data/types';
import { PLACEHOLDER_SRC, slideStyle } from '@/lib/media';

interface Props {
  gallery: MediaGallery;
}

const { gallery } = Astro.props;
const [first] = gallery.items;
const isCarousel = gallery.items.length > 1;

/** Shared <img> attributes. Only the first slide loads eagerly-lazy; others wait for `data-src`. */
const imgAttrs = (item: MediaItem, deferred: boolean) => ({
  src: deferred ? PLACEHOLDER_SRC : item.src,
  'data-src': deferred ? item.src : undefined,
  alt: item.alt,
  loading: 'lazy' as const,
  decoding: 'async' as const,
  referrerpolicy: item.remote ? ('no-referrer' as const) : undefined,
  tabindex: 0,
  role: 'button' as const,
});
---

{isCarousel ? (
  <section
    class="feature-media media-carousel"
    data-carousel
    aria-roledescription="carousel"
    aria-label={gallery.label}
    style={gallery.background ? `--carousel-bg:${gallery.background}` : undefined}
  >
    <div class="carousel-track">
      {gallery.items.map((item, i) => (
        <figure
          class:list={['carousel-slide', `carousel-slide--${item.fit}`, { 'is-active': i === 0 }]}
          style={slideStyle(item)}
        >
          <img {...imgAttrs(item, i > 0)} />
          {item.caption && <figcaption class="carousel-caption">{item.caption}</figcaption>}
        </figure>
      ))}
    </div>
    <button class="carousel-btn prev" type="button" aria-label="Previous media">
      ‹
    </button>
    <button class="carousel-btn next" type="button" aria-label="Next media">
      ›
    </button>
    <div class="carousel-dots" role="group" aria-label={`Choose ${gallery.label}`}>
      {gallery.items.map((_, i) => (
        <button
          class:list={['carousel-dot', { 'is-active': i === 0 }]}
          type="button"
          aria-label={`Show media ${i + 1}`}
          aria-current={i === 0 ? 'true' : undefined}
        />
      ))}
    </div>
    <span class="badge">{gallery.badge}</span>
  </section>
) : (
  <div class="feature-media diagram-frame">
    <img {...imgAttrs(first, false)} />
    <span class="badge">{gallery.badge}</span>
  </div>
)}
