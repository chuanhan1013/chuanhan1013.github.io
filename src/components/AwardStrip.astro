---
import type { Award } from '@/data/types';

interface Props {
  awards: Award[];
}

const { awards } = Astro.props;
---

<ul class="awards">
  {awards.map((award) => (
    <li class="award reveal">
      <img
        src={award.icon.src}
        alt={award.icon.alt}
        style={`--icon-padding:${award.icon.padding}`}
        loading="lazy"
        decoding="async"
        referrerpolicy={award.icon.remote ? 'no-referrer' : undefined}
      />
      <strong>{award.title}</strong>
      <span>{award.text}</span>
    </li>
  ))}
</ul>
