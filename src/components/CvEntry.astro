---
import type { CvEntry } from '@/data/cv';

interface Props {
  entry: CvEntry;
}

const { entry } = Astro.props;
---

<div class="entry">
  <div class="entry-head">
    <strong>{entry.title}</strong>
    <span>{entry.right}</span>
  </div>
  {(entry.sub || entry.subRight) && (
    <div class="entry-sub">
      <span>{entry.sub}</span>
      <span>{entry.subRight}</span>
    </div>
  )}
  {entry.note && <p class="entry-note">{entry.note}</p>}
  {entry.bullets && (
    <ul>
      {entry.bullets.map((bullet) => (
        <li>{bullet}</li>
      ))}
    </ul>
  )}
</div>
