---
import type { SkillGroup } from '@/data/types';
import { iconUrl } from '@/lib/icons';
import Stack from './Stack.astro';

interface Props {
  group: SkillGroup;
}

const { group } = Astro.props;
---

<div class="skill-group reveal">
  <h3>
    <img src={iconUrl(group.icon)} alt="" width="30" height="30" loading="lazy" />
    {group.title}
  </h3>
  <Stack items={group.items} dots label={group.title} />
</div>
