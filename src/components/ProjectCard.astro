---
import { categories } from '@/data/categories';
import { iconUrl } from '@/lib/icons';
import { isVideo, mediaStyle, stillOf } from '@/lib/media';
import { coverOf, projectUrl, transitionName, type ProjectEntry } from '@/lib/projects';
import StatusBadge from './StatusBadge.astro';

/**
 * Project tile for the home page: media first, plain short name, no frame, one plain sentence
 * (`blurb`) and one headline result. Everything else lives on the project page.
 */
interface Props {
  entry: ProjectEntry;
}

const { entry } = Astro.props;
const p = entry.data;
const cover = coverOf(entry);
const [firstCategory] = p.categories;
const primary = firstCategory ? categories[firstCategory].short : undefined;
const headline = p.results?.[0];
const hasCode = p.links?.some((link) => link.href.includes('github.com'));
---

<article class="project-card">
  <figure
    class:list={['project-card__cover', { 'project-card__cover--diagram': cover.fit === 'diagram' }]}
    style={mediaStyle(cover, 'cover')}
  >
    {isVideo(cover) ? (
      <video
        class="card-clip"
        muted
        loop
        playsinline
        preload="none"
        poster={cover.poster}
        data-src={cover.src}
        aria-hidden="true"
        style={`view-transition-name:${transitionName(entry, 'cover')}`}
      />
    ) : (
      <img
        src={stillOf(cover)}
        alt=""
        loading="lazy"
        decoding="async"
        referrerpolicy={cover.remote ? 'no-referrer' : undefined}
        style={`view-transition-name:${transitionName(entry, 'cover')}`}
      />
    )}
    {p.status !== 'completed' && <StatusBadge status={p.status} />}
  </figure>
  <div class="project-card__body">
    <div class="card-meta">
      {primary && <span>{primary}</span>}
      {primary && (
        <span class="sep" aria-hidden="true">
          ·
        </span>
      )}
      <span>{p.period}</span>
      {hasCode && (
        <span class="project-card__code">
          <img src={iconUrl('github')} alt="" width="13" height="13" />
          Code
        </span>
      )}
    </div>
    <h3 style={`view-transition-name:${transitionName(entry, 'title')}`}>
      <a href={projectUrl(entry)}>{p.shortTitle ?? p.title}</a>
    </h3>
    <p class="project-card__summary">{p.blurb ?? p.summary}</p>
    {headline && (
      <p class="project-card__headline">
        <strong>{headline.value}</strong>
        <span>{p.headlineLabel ?? headline.label}</span>
      </p>
    )}
  </div>
</article>
