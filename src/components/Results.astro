---
interface Props {
  results: { value: string; label: string }[];
}

const { results } = Astro.props;

/** Keep fractions such as "4 / 4" on one line. */
const nb = (text: string) => text.replace(/(\d) \/ (\d)/g, '$1\u00a0/\u00a0$2');
---

<dl class="results">
  {results.map((r) => (
    <div>
      <dt>{nb(r.value)}</dt>
      <dd>{nb(r.label)}</dd>
    </div>
  ))}
</dl>
