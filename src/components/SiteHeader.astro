---
import { nav, person, profile } from '@/data/site';

interface Props {
  /** On sub-pages, section links point back to the home page. */
  home?: boolean;
}

const { home = true } = Astro.props;
const href = (anchor: string) => (home ? anchor : `/${anchor}`);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="wordmark" href={home ? '#top' : '/'}>
      <img src={profile.avatar.src} alt="" width="32" height="32" />
      {person.name}
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span></span>
      <span></span>
      <span class="sr-only">Toggle navigation</span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Primary navigation">
      {nav.map((item) => (
        <a href={href(item.href)}>{item.label}</a>
      ))}
      <a class="nav-cta" href="/cv.html">
        CV ↗
      </a>
      <span class="nav-indicator" aria-hidden="true"></span>
    </nav>
  </div>
</header>
