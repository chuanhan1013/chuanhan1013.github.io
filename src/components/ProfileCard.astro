---
import { person, profile } from '@/data/site';
import { iconUrl } from '@/lib/icons';
---

<aside class="profile-column">
  <div class="profile-card">
    <img
      class="avatar"
      src={profile.avatar.src}
      alt={profile.avatar.alt}
      width="172"
      height="172"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <p class="eyebrow">{profile.eyebrow}</p>
    <h1>
      {person.nameLines[0]}
      <br />
      {person.nameLines[1]}
    </h1>
    <p class="profile-role">
      {profile.role[0]}
      <br />
      {profile.role[1]}
      <span class="profile-subdegree">
        {profile.subdegree[0]}
        <br />
        {profile.subdegree[1]}
      </span>
    </p>
    <div class="profile-rule"></div>
    <dl class="profile-facts">
      {profile.facts.map((fact) => (
        <div>
          <dt>{fact.term}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))}
    </dl>
    <div class="profile-links">
      {profile.links.map((link) => (
        <a href={link.href} {...(link.external && { target: '_blank', rel: 'noreferrer' })}>
          <span class="profile-icon">
            <img src={iconUrl(link.icon)} alt="" loading="lazy" decoding="async" />
          </span>
          {link.label}
        </a>
      ))}
    </div>
  </div>
  <a class="download-card" href="/cv.html">
    <span>
      <small>CURRICULUM VITAE</small>
      <strong>View / save CV</strong>
    </span>
    <b>↗</b>
  </a>
</aside>
